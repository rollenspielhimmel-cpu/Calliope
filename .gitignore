.env
# Per-checkout, like .env: the preview tooling's port cannot be read from .env, so a
# second checkout has to state its own. Copy .claude/launch.example.json.
.claude/launch.json

# Local scratch notes; never commit
abc
abc.*

# Appended to by both test runners, and never truncated — so it is a record of this checkout's
# flaky failures, which is nobody else's. See the Tests section of either AGENTS.md.
test-failures.log

# The JUnit report `deno task test` parses the log out of, overwritten every run.
backend/.test-report.xml

node_modules/

# Uploaded files in development; the deployed one is a Docker volume.
.file-storage/

.DS_Store

# Diese Freigabe gilt nur für diesen Rechner und nennt die Adresse des Servers.
.claude/settings.local.json

# Das Windows-Programm, mit dem hier Migrationen laufen. Es liegt auf der Platte, nicht im
# Repository: 32,7 MB, die sonst jeder Klon mitschleppt. CI lädt sich dbmate selbst herunter,
# der Deploy benutzt das Abbild `amacneil/dbmate` — gebraucht wird die Datei also nur lokal.
dbmate.exe

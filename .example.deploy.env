# Which instance this is: development, testing, staging or production. `testing` is a public
# instance whose database is reset when a migration calls for it; `staging` is close enough to
# production that it is not. Anything but production says so on the sign-in page, the
# registration page and the home page, and carries a badge in the top bar.
#
# Deliberately empty rather than defaulted: copying this file and forgetting one line must not
# produce a box that calls itself production. The frontend build fails until it is filled in,
# which is the loud direction to fail in — the quiet one tells members their writing is safe
# when it is not.
ENVIRONMENT=""

# The public address of the deployment. Caddy requests a certificate for it, the backend
# allows it as a CORS origin, and it becomes the `servers` entry of the OpenAPI document.
HOST_URL="https://calliope.example.com"

# What this deployment calls itself. Calliope is meant to be run by other communities under
# their own name: this is the name in the browser tab, the wordmark, and the OpenAPI document.
# Leave them out to run as the reference implementation.
#
# Renaming does not reach the logo or the icons — those are the letter C, outlined from
# Newsreader. See `frontend/src/assets/logo/README.md` for how they were produced.
APP_NAME="Calliope"

# Where the footer sends somebody who wants the code. Point a fork at **its own** source: the
# licence is AGPL, and a modified instance owes its users the version it is actually running —
# not the project it came from.
SOURCE_URL="https://github.com/maximilian-hammerl/calliope"
APP_DESCRIPTION=""

# Omitted from the OpenAPI document entirely when unset, rather than defaulted to somebody.
APP_CONTACT_NAME=""
APP_CONTACT_EMAIL_ADDRESS=""

# The legal notice at /imprint. The first two are required and the frontend build refuses without
# them; the rest are optional. Postal code and town go together or not at all.
IMPRINT_NAME=""
IMPRINT_EMAIL_ADDRESS=""
IMPRINT_STREET=""
IMPRINT_POSTAL_CODE=""
IMPRINT_CITY=""
IMPRINT_TELEPHONE=""

# ── The gate ────────────────────────────────────────────────────────────────────────────────
#
# One shared password in front of the whole site, for as long as there is no Impressum. It is not
# a substitute for one — it is what makes „not open to the public" true while it is being written.
# Everything is behind it: the interface, the API, the OpenAPI document and the uploaded files.
#
# Two forms of one secret, because they are read by two different things and neither can derive
# the other. Caddy takes only the hash; `deploy.sh` needs the password itself to get past the gate
# when it checks what the deployment is serving. **Change one and you must change the other**, or
# the deploy stops with a 401 and says so.
#
# The hash is bcrypt, made on the server so the password is never typed into a file that syncs
# anywhere:
#
#     docker run --rm caddy:2 caddy hash-password --plaintext 'the-password'
#
# Leaving the hash empty makes Caddy refuse to start, which fails the deploy — the same direction
# ENVIRONMENT fails in, and for the same reason: a box that quietly served itself to everybody is
# the mistake worth making impossible.
#
# **Removing the gate** once the Impressum is up: delete the `route` wrapper in the Caddyfile and
# these three lines. `deploy.sh` runs its checks unauthenticated when they are absent.
GATE_USERNAME="rsh"
GATE_PASSWORD="change-me"
GATE_PASSWORD_HASH=""

# The first administrator, created at the first start that finds none. The username is "Admin";
# only the password is set here.
#
# Used **once**. A later start finds the account and leaves it alone, so changing this line does
# not change the password — do that in the interface. Deleting the account makes the next start
# create it again from this value.
#
# Left empty, the deployment has no administrator: a box nobody can moderate.
ROOT_ADMIN_PASSWORD=""

# Only used inside the compose network; the database is not published to the host.
POSTGRES_PASSWORD="change-me"

# Where the registration form checks a password against known breaches. Required by both the
# backend and the compose file, so a deployment without it does not start.
#
# Stated rather than defaulted, because reaching a third party is a decision a deployment makes:
# only the first five characters of the hash ever leave the server.
PWNED_PASSWORDS_URL="https://api.pwnedpasswords.com/range"

# ── The interim mailbox ─────────────────────────────────────────────────────────────────────
#
# Only while the SMTP settings below point at Mailpit. Its web interface is served under
# HOST_URL/<MAILPIT_WEBROOT>, behind a password of its **own**.
#
# Never the same credentials as the gate above. Every password-reset link the platform sends
# passes through this mailbox, so whoever can read it can take over any account. The gate password
# is meant to be handed to a group of testers; this one belongs to the team and nobody else.
#
# The hash is made the same way:
#
#     docker run --rm caddy:2 caddy hash-password --plaintext 'the-password'
MAILPIT_WEBROOT="postfach"
MAILBOX_USERNAME="team"
MAILBOX_PASSWORD_HASH=""

# ── Outgoing mail ───────────────────────────────────────────────────────────────────────────
#
# Pointing at the Mailpit container means **nothing reaches a real inbox**: registration
# confirmations, password resets and notifications all stop in the mailbox above, and somebody has
# to pass them on by hand. Good enough for a closed test, and not something to launch on.
#
# For a real relay: host and port of the account, SECURE=true for 465 and false for 587, and see
# "Outgoing mail" in deployment/README.md — the sending domain needs SPF, DKIM and DMARC, and
# MAIL_FROM_ADDRESS has to be an address that account may send as.
#
# USERNAME and PASSWORD may be empty, and are while this is Mailpit: an empty username means "no
# credentials", which is what a server that wants none expects. They must still be present.
SMTP_HOST="mail.example.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USERNAME="calliope@example.com"
SMTP_PASSWORD="change-me"

MAIL_FROM_ADDRESS="calliope@example.com"

# Where uploaded files are written. Gitignored in development; a Docker volume in the deployment,
# which is why the two differ.
FILE_STORAGE_PATH="/data/files"
